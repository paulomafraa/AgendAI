# Copie para .env e preencha (nunca commite o .env com segredos reais se o repo for público)

# Chave Gemini / OpenAI / Anthropic também pode ser colada só no app (Ajustes).
# EXPO_PUBLIC_GEMINI_API_KEY=

# OAuth Google (Calendar + Tasks) — Client ID tipo "Web application"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Opcionais para builds nativos:
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
